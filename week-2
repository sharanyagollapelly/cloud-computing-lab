[Unit]
Description=Gunicorn instance for Flask app
After=network.target
[Service]
User=rgukt-basar
Group=www-data
WorkingDirectory=/home/rgukt-basar/flaskapp
Environment="PATH=/home/rgukt-basar/flaskapp/vnev/bin"
ExecStart=/home/rgukt-basar/flaskapp/vnev/bin/gunicorn --workers 3 --bind unix:/home/rgukt-basar/flaskapp/flaskapp.sock >
Restart=always
[Install]
WantedBy=multi-user.target

 
 
 
 
 
 
 
